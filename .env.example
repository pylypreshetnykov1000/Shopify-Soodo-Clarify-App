SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
SCOPES=read_products,write_products,read_metaobjects,read_legal_policies,read_orders
# AI visibility tests (Google AI Studio key). Without it the page explains how to turn them on.
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-latest
# Never enable DEMO_MODE on a deployed app.
DEMO_MODE=false
# On Render, use the PostgreSQL database's Internal Database URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
