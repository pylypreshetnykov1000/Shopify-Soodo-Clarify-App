model Store {
  shop        String   @id
  category    String   @default("outdoor")
  syncCursor  String?
  syncedAt    DateTime?
  syncStarted DateTime?
  syncToken   String?
  syncLease   DateTime?
  scanRun     String?
  products    CatalogProduct[]
