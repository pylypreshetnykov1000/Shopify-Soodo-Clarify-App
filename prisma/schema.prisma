// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  shop        String   @id
  category    String   @default("auto")
  syncCursor  String?
  syncedAt    DateTime?
  syncStarted DateTime?
  syncToken   String?
  syncLease   DateTime?
  scanRun     String?
  scanTotal   Int?
  profile     String?
  profileAt   DateTime?
  /// Overview shows the detailed dashboard instead of the simple view.
  detailed    Boolean  @default(false)
  /// AI-referred order sync: progress while running, totals once finished.
  ordersSync  String?
  orderStats  String?
  ordersSyncedAt DateTime?
  products    CatalogProduct[]
  snapshots   ReadinessSnapshot[]
  aiOrders    AiOrder[]
}

/// An order whose visit came from an AI assistant. Holds no customer data.
model AiOrder {
  id          String   @id @default(cuid())
  shop        String
  orderGid    String
  name        String
  createdAt   DateTime
  amount      Float
  currency    String
  assistant   String
  touch       String
  landingPage String?
  store       Store    @relation(fields: [shop], references: [shop], onDelete: Cascade)
  @@unique([shop, orderGid])
  @@index([shop, createdAt])
}

/// One readiness reading per store per UTC day, for the trend chart.
model ReadinessSnapshot {
  id        String   @id @default(cuid())
  shop      String
  day       String
  createdAt DateTime @default(now())
  readiness Int
  ready     Int
  active    Int
  fixes     Int
  store     Store    @relation(fields: [shop], references: [shop], onDelete: Cascade)
  @@unique([shop, day])
}

model CatalogProduct {
  id          String   @id @default(cuid())
  shop        String
  gid         String
  title       String
  payload     String
  seenAt      DateTime @default(now())
  cacheUpdatedAt DateTime @default(now())
  scanRun     String?
  deleted     Boolean  @default(false)
  lockToken   String?
  lockUntil   DateTime?
  liveCheck   String?
  liveCheckedAt DateTime?
  store      Store @relation(fields: [shop], references: [shop], onDelete: Cascade)
  suggestions Suggestion[]
  changes     Change[]
  @@unique([shop, gid])
  @@index([shop, deleted])
}

model Suggestion {
  id          String   @id @default(cuid())
  productId   String
  /// "description" or "seo" (search listing: JSON {title, description}).
  kind        String   @default("description")
  fingerprint String
  beforeHtml  String
  afterHtml   String
  facts       String
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  changes     Change[]
  @@index([productId, status])
}

model Change {
  id           String   @id @default(cuid())
  productId    String
  kind         String   @default("description")
  suggestionId String
  beforeHtml   String
  afterHtml    String
  status       String   @default("PUBLISHING")
  requestOutcome String @default("PENDING")
  message      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  @@index([productId, status])
}
